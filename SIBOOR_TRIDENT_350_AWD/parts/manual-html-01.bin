@media(max-width:720px){.fact-grid,.video-feature,.video-list,.resource-grid{grid-template-columns:1fr}.ref-table{font-size:11px}.ref-table td,.ref-table th{padding:7px 5px}.video-feature{padding:10px}}
@media print{
 .priority-alert{background:#fff6ea!important;border:1px solid #d3b090!important;border-left:4px solid #b47f43!important}

a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
.topbar{position:sticky;top:0;background:#102b3b;color:#fff;display:flex;gap:12px;align-items:center;justify-content:space-between;padding:10px 20px;z-index:100;box-shadow:0 1px 12px #0002}.topbar strong{letter-spacing:.04em}.top-actions{display:flex;gap:8px;align-items:center}button,.action{border:1px solid #bcd1d8;background:#fff;color:#143648;border-radius:9px;padding:8px 12px;font-weight:600;font-size:13px;cursor:pointer}.topbar .action{background:#16465c;color:white;border-color:#568298}.app{display:grid;grid-template-columns:240px minmax(0,880px);justify-content:center;gap:28px;max-width:1220px;margin:28px auto;padding:0 20px}.sidebar{align-self:start;position:sticky;top:75px;max-height:calc(100vh - 100px);overflow:auto;background:#fff;border:1px solid var(--line);padding:18px;border-radius:14px}.sidebar .smalltitle{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.10em;font-weight:700;margin-bottom:10px}.sidebar a{display:block;padding:6px 8px;border-radius:7px;font-size:13px;color:#28485a}.sidebar a:hover{background:var(--soft)}.content{min-width:0}.cover{border-radius:18px;padding:36px 40px;background:#13384c;color:white;position:relative;overflow:hidden;margin-bottom:18px}.cover:after{content:"350";position:absolute;right:-10px;bottom:-70px;font-weight:800;font-size:210px;opacity:.055}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#9dd1df;font-weight:800}.cover h1{font-size:39px;line-height:1.04;letter-spacing:-.03em;margin:16px 0}.cover p{color:#d9ebef;max-width:610px}.meta{display:flex;flex-wrap:wrap;gap:9px;margin:14px 0 0}.meta span{font-size:12px;border:1px solid #6391a2;border-radius:20px;padding:5px 10px;color:#ddf6fa}.chapter{background:#fff;border:1px solid var(--line);border-radius:15px;margin:16px 0;padding:28px 34px;break-inside:avoid-page}.chapter-head{display:flex;gap:16px;align-items:start;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:17px}.chapter-no{color:#0e6e8c;background:#e9f5f7;border-radius:8px;padding:6px 9px;font-weight:900;min-width:43px;text-align:center}.chapter h2{font-size:24px;line-height:1.18;letter-spacing:-.02em;margin:2px 0 5px}.ref{font-size:12px;color:var(--muted)}.step{position:relative;padding:12px 10px 12px 37px;border-bottom:1px solid #ecf0f2;break-inside:avoid}.step:last-child{border-bottom:0}.step input{position:absolute;left:7px;top:16px;accent-color:#0e6e8c;width:17px;height:17px}.step label{font-weight:730;display:block;margin-bottom:4px;cursor:pointer}.step p{font-size:14px;color:#3a5160;margin:0}.step.done{opacity:.58}.step.done label{text-decoration:line-through}.note{padding:16px 19px;border-left:4px solid #c07a2c;background:#fff8ea;color:#643a12;border-radius:7px;margin:15px 0 0;break-inside:avoid}.note strong{display:block}.info{padding:15px 18px;background:#e7f3f6;border-radius:9px;margin:16px 0;color:#1e5065}.source-links{display:flex;gap:8px;flex-wrap:wrap}.source-links a{background:#eef5f7;padding:8px 12px;border-radius:8px;font-size:13px}.stats{font-weight:700;font-size:13px;color:#cce9f0}.diagrams{display:grid;grid-template-columns:1fr 1fr;gap:12px}.diagram{padding:14px;border:1px solid var(--line);border-radius:10px;background:#fbfdfe}.diagram svg{width:100%;max-height:220px}.diagram p{font-size:12px;color:var(--muted);margin:4px 0 0}.intro{padding:21px 28px;background:white;border:1px solid var(--line);border-radius:14px}.intro strong{color:#294f62}.disclaimer{font-size:12px;color:var(--muted)}.controls{margin-top:12px;display:flex;flex-wrap:wrap;gap:8px}.toc-title{margin:4px 0 13px}.micro{font-size:12px;color:#627f8b}.last{margin-bottom:40px}.labelcaps{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:#598294;font-weight:800}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px} .check-badge{display:inline-block;border-radius:4px;font-size:11px;padding:2px 7px;background:#e7f4ee;color:#30644f;font-weight:700}
@media(max-width:830px){.app{display:block;padding:0 10px;margin:12px auto}.sidebar{display:none}.topbar{padding:8px}.cover{padding:25px}.cover h1{font-size:33px}.chapter{padding:20px 16px}.diagrams,.two{grid-template-columns:1fr}.topbar .brand{font-size:12px}.topbar button,.topbar .action{padding:7px;font-size:11px}}
